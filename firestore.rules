rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Products: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: customer reads own, admin reads all
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Users: user reads own profile, admin reads all
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Cart & Wishlist: user's own data
    match /cart/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }
    match /wishlist/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // Settings: admin only
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // Admin emails: admin only
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // Contacts & Newsletter: anyone can create, admin reads
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /newsletter/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Reviews: authenticated create, public read
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Activity logs: admin only
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
